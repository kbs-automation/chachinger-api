ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://cha3535:cha3535@localhost:5432/cha3535
REDIS_URL=redis://localhost:6379/0

# RS256 PEM keys (use \n for newlines). Generate with: python scripts/generate_jwt_keys.py
# Left empty in development, an ephemeral key pair is generated at startup.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ADMIN_JWT_SECRET=<separate admin secret>
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_VIP_PRICE_ID=price_...
STRIPE_BLACK_PRICE_ID=price_...
STRIPE_ELITE_PRICE_ID=price_...
STRIPE_DIAMOND_PRICE_ID=price_...
CHECKOUT_SUCCESS_URL=https://app.cha3535.com/billing/success
CHECKOUT_CANCEL_URL=https://app.cha3535.com/billing/cancel
PORTAL_RETURN_URL=https://app.cha3535.com/account

AWS_REGION=us-east-1
AWS_S3_BUCKET=cha3535-avatars
# s3 | local  (local stores avatars under LOCAL_MEDIA_DIR and serves them at /media)
STORAGE_BACKEND=local
LOCAL_MEDIA_DIR=./media

SENTRY_DSN=
DATADOG_API_KEY=
CORS_ORIGINS=https://app.cha3535.com,https://admin.cha3535.com
RATE_LIMIT_ENABLED=true
